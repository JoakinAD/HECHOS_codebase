{
  "run_name": "spa_dev_distiluse_distance_hac",
  "dataset": {
    "type": "priberam",
    "path": "/mnt/92F0D455F0D440E1/Universidad/Quinto_ano/tfg/HECHOS_codebase/news_clustering/dataset/dataset.dev.json",
    "language": "spa"
  },
  "representation": "hybrid_distance",
  "encoder": "distiluse_multilingual",
  "weights": {
    "semantic": 0.5,
    "tfidf": 0.3,
    "temporal": 0.2
  },
  "temporal": {
    "mu_days": 0.0,
    "sigma_days": 3.0
  },
  "clusterer": {
    "name": "hac",
    "hac": {
      "distance_threshold": 0.5
    },
    "hdbscan": {
      "min_cluster_size": 2,
      "min_samples": 1
    },
    "birch": {
      "threshold": 0.5,
      "branching_factor": 50
    }
  },
  "output_dir": "outputs"
}