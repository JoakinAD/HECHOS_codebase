{
  "run_name": "spa_dev_distiluse_distance_hdbscan",
  "dataset": {"type": "priberam", "path": "dataset/dataset.dev.json", "language": "spa"},
  "representation": "hybrid_distance",
  "encoder": "distiluse_multilingual",
  "weights": {"semantic": 0.5, "tfidf": 0.3, "temporal": 0.2},
  "temporal": {"mu_days": 0.0, "sigma_days": 3.0},
  "clusterer": {
    "name": "hdbscan",
    "hac": {"distance_threshold": 0.5},
    "hdbscan": {"min_cluster_size": 2, "min_samples": 1},
    "birch": {"threshold": 0.5, "branching_factor": 50}
  },
  "output_dir": "outputs"
}
